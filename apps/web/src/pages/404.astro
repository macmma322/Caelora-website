---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Beyond the map — Caelora" noindex>
  <main id="main" class="container document">
    <span class="eyebrow">404 / Beyond the map</span>
    <h1>
      This path leads
      <br />
      into the unknown.
    </h1>
    <p>The page you are looking for has moved, or has not been built yet.</p>
    <a class="button" href="/">
      Return to familiar ground <span aria-hidden="true">↗</span>
    </a>
  </main>
</SiteLayout>
