---
import SiteLayout from '../layouts/SiteLayout.astro';
import PlaceHero from '../components/PlaceHero.astro';
import PlaceTravel from '../components/PlaceTravel.astro';
import StatusTag from '../components/StatusTag.astro';
import { placeById } from '../data/places';
const place = placeById('village');
// The intended rhythm of a day. Villagers with routines are planned, not implemented.
const day = [
  ['Dawn', 'Smoke from the first chimneys. Livestock stirring in the fields.'],
  ['Midday', 'Work in the yards and at the river. Someone with something to trade.'],
  ['Dusk', 'Lamps lit along the bridge. The road home getting shorter.'],
  ['Night', 'Shutters closed. The forest louder than the village.'],
];
---

<SiteLayout
  title="The Village — Caelora"
  description="Villages, villagers, trade and wildlife: the living world of Caelora, an independent medieval-fantasy voxel sandbox in development."
>
  <main id="main" class="place place-village-page">
    <PlaceHero place={place} title="It goes on <em>without you.</em>" />

    <section class="daybook section-space" aria-labelledby="day-title">
      <div class="container daybook-grid">
        <header class="daybook-head" data-reveal>
          <span class="eyebrow">A day in the valley</span>
          <h2 id="day-title">
            Lives that do not <em>wait for you.</em>
          </h2>
          <p class="lede">
            The aim is a valley with business of its own: people with routines, places to trade, a
            reason to stop and stay.
          </p>
          <StatusTag status="planned" label="Villagers and daily routines are planned" />
        </header>
        <ol class="daybook-hours">
          {day.map(([hour, text], index) => (
            <li class={`hour hour-${index + 1}`} data-reveal>
              <span class="hour-name">{hour}</span>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="belong section-space" aria-labelledby="belong-title">
      <div class="container belong-grid" data-reveal>
        <h2 id="belong-title">
          Join them, <em>or keep wandering.</em>
        </h2>
        <div>
          <p>
            Trade with neighbours. Find a guild. Or pass through, buy what you need and keep to the
            road. Belonging should be a possibility, never a requirement.
          </p>
          <ul class="status-list">
            <li>
              <StatusTag status="development" /> Wildlife and livestock
            </li>
            <li>
              <StatusTag status="planned" /> Villagers, settlements and trade
            </li>
          </ul>
          <a class="text-link" href="/bestiary/">
            Meet the wild ones <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <PlaceTravel place={place} />
  </main>
  <script>
    import '../scripts/experience';
  </script>
</SiteLayout>
