---
import SiteLayout from '../layouts/SiteLayout.astro';
const studies = [
  {
    src: 'valley-1672',
    width: 1672,
    height: 941,
    title: 'Beyond the familiar',
    kind: 'Environment study',
    alt: 'A traveller and falcon overlook a forested valley, stone settlements and a castle in warm evening light.',
  },
  {
    src: 'dragon-960',
    width: 960,
    height: 840,
    title: 'Something older than kingdoms',
    kind: 'Creature study',
    alt: 'An angular horned dragon with layered charcoal scales and wide ochre-red wings.',
  },
  {
    src: 'atlas-960',
    width: 960,
    height: 720,
    title: 'A world waiting to be charted',
    kind: 'Atlas study',
    alt: 'An ornate open atlas illustrating imagined forests, rivers, villages and mountain ranges.',
  },
];
---

<SiteLayout>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <picture class="hero-art">
        <source media="(max-width:40rem)" srcset="/media/valley-960.webp" />
        <img
          src="/media/valley-1672.webp"
          width="1672"
          height="941"
          alt="Caelora environment concept: a cloaked traveller, a falcon and a vast valley beneath a dragon and a distant castle."
          fetchpriority="high"
        />
      </picture>
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <span class="hero-kicker eyebrow">
          <span class="status-dot" aria-hidden="true"></span> An independent fantasy sandbox · In
          development
        </span>
        <h1 id="hero-title">
          <span class="sr-only">Caelora</span>
          <img
            class="hero-logo"
            src="/brand/caelora-logo.webp"
            width="1000"
            height="353"
            alt=""
            fetchpriority="high"
          />
        </h1>
        <p class="hero-promise">
          A world to inhabit.
          <br />
          <span>Not a story you are forced to finish.</span>
        </p>
        <p class="hero-description">
          Find your own way through the wilderness.
          <br />
          Leave a little of yourself behind.
        </p>
        <div class="hero-actions">
          <a class="button" href="#world">
            Enter the world <span aria-hidden="true">↘</span>
          </a>
          <a class="button secondary" href="#journal">
            From the workshop <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="container hero-foot">
        <a href="#world" class="scroll-note">
          <span aria-hidden="true">↓</span> Discover Caelora
        </a>
        <span>Environment concept · Not gameplay footage</span>
      </div>
    </section>
    <section class="container introduction section-space" id="world" aria-labelledby="world-title">
      <div>
        <span class="eyebrow">A place before a prophecy</span>
        <h2 id="world-title">
          Not every adventure
          <br />
          needs a <em>chosen one.</em>
        </h2>
      </div>
      <div class="introduction-copy">
        <p class="lead">
          Some worlds give you a story.
          <br />
          This one is being built to make room for yours.
        </p>
        <p>
          Caelora is a medieval-fantasy voxel sandbox in development. Exploration, gathering,
          building and survival are the foundations of a world you can make your own.
        </p>
        <a class="text-link" href="/journal/foundation/">
          Read the founding vision <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="landscape" aria-labelledby="explore-title">
      <img
        src="/media/valley-1672.webp"
        width="1672"
        height="941"
        alt="Valley environment concept, with pine forests and waterfalls beneath distant stone architecture."
        loading="lazy"
      />
      <div class="landscape-shade"></div>
      <div class="container landscape-content">
        <span class="eyebrow">01 / Explore</span>
        <h2 id="explore-title">
          There is always
          <br />
          another horizon.
        </h2>
        <p>
          A ruin across the river. A light beyond the trees.
          <br />
          The freedom to follow your curiosity.
        </p>
        <span class="art-label">The exploration vision / Environment concept</span>
      </div>
      <div class="landscape-index" aria-hidden="true">
        <span>FOREST</span>
        <i></i>
        <span>STONE</span>
        <i></i>
        <span>SKY</span>
      </div>
    </section>
    <section class="container section-space paths" id="your-path" aria-labelledby="paths-title">
      <div class="paths-heading">
        <span class="eyebrow">02 / Make a life here</span>
        <h2 id="paths-title">
          A shelter.
          <br />A settlement.
          <br />
          <em>A sense of belonging.</em>
        </h2>
        <p>
          From your first gathered materials to the place you call home: the small things should
          matter.
        </p>
        <span class="development-note">Development direction — not a released feature list.</span>
      </div>
      <div class="path-list">
        <article>
          <span class="path-number">I</span>
          <div>
            <h3>Build with purpose.</h3>
            <p>
              Gather, shape and build. The vision begins with a first shelter and leaves room for
              something more personal.
            </p>
            <span class="eyebrow">Building</span>
          </div>
        </article>
        <article>
          <span class="path-number">II</span>
          <div>
            <h3>Learn the wilderness.</h3>
            <p>
              Find resources, prepare for the journey and make survival part of everyday life — not
              just a number on a screen.
            </p>
            <span class="eyebrow">Survival</span>
          </div>
        </article>
        <article>
          <span class="path-number">III</span>
          <div>
            <h3>Find your people.</h3>
            <p>
              Villagers, guilds and kingdoms belong to the intended world. Player-created nations
              are a longer-term ambition.
            </p>
            <span class="eyebrow">Villages & kingdoms</span>
          </div>
        </article>
      </div>
    </section>
    <section class="creature-section" aria-labelledby="creature-title">
      <div class="container creature-inner">
        <figure class="creature-art">
          <img
            src="/media/dragon-960.webp"
            width="960"
            height="840"
            alt="A Caelora dragon concept, preserving its horns, wing structure and layered scales."
            loading="lazy"
          />
          <figcaption class="art-label">Creature concept / Visual development</figcaption>
        </figure>
        <div class="creature-copy">
          <span class="eyebrow">03 / Meet the extraordinary</span>
          <h2 id="creature-title">
            Look up.
            <br />
            <em>You are not alone.</em>
          </h2>
          <p>
            Dragons, wildlife and mythical creatures are part of Caelora’s vision. The world should
            feel inhabited long before you arrive.
          </p>
          <p class="development-note">
            Creature designs and gameplay systems are still in development.
          </p>
          <a class="text-link" href="#media">
            Explore the concept studies <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
    <section class="container freedom section-space" aria-labelledby="freedom-title">
      <span class="eyebrow">04 / Choose your own path</span>
      <h2 id="freedom-title">
        Follow the lore.
        <br />
        Or just <em>follow the river.</em>
      </h2>
      <p>
        Be a wanderer, a builder, a little of both.
        <br />
        The ambition is freedom — including the freedom to take your time.
      </p>
      <div class="freedom-rule" aria-hidden="true"></div>
    </section>
    <section class="journal-section section-space" id="journal" aria-labelledby="journal-title">
      <div class="container">
        <div class="section-row">
          <div>
            <span class="eyebrow">The development journal</span>
            <h2 id="journal-title">A world in the making.</h2>
          </div>
          <span class="development-note">Notes from an independent project</span>
        </div>
        <a class="journal-entry" href="/journal/foundation/">
          <div class="journal-image">
            <img
              src="/media/atlas-960.webp"
              width="960"
              height="720"
              alt="Caelora's illustrated atlas concept, an early visual study of an imagined world."
              loading="lazy"
            />
            <span class="image-note">Atlas concept</span>
          </div>
          <div class="journal-copy">
            <span class="eyebrow">
              Founding note · <time datetime="2026-10-15">15 October 2026</time>
            </span>
            <h3>
              Making room for
              <br />
              your kind of adventure.
            </h3>
            <p>
              The idea behind Caelora, the world-first approach, and an honest account of what this
              beginning promises.
            </p>
            <span class="text-link">
              Read the journal <span aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
      </div>
    </section>
    <section class="container section-space media-section" id="media" aria-labelledby="media-title">
      <div class="section-row">
        <div>
          <span class="eyebrow">From the artist’s table</span>
          <h2 id="media-title">Glimpses of Caelora.</h2>
        </div>
        <p class="development-note">
          Concept artwork, not gameplay.
          <br />
          Open a study to see the full composition.
        </p>
      </div>
      <div class="gallery">
        {studies.map((art, index) => (
          <figure class:list={['gallery-item', { 'gallery-wide': index === 0 }]}>
            <a
              href={'/media/' + art.src + '.webp'}
              data-artwork={index}
              aria-label={'View ' + art.title}
            >
              <img
                src={'/media/' + art.src + '.webp'}
                width={art.width}
                height={art.height}
                alt={art.alt}
                loading="lazy"
              />
              <span class="gallery-open" aria-hidden="true">
                ↗
              </span>
            </a>
            <figcaption>
              <span>{art.title}</span>
              <span class="eyebrow">{art.kind}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
    <section class="closing">
      <div class="container closing-inner">
        <div>
          <span class="eyebrow">Build. Explore. Belong.</span>
          <h2>
            A world worth
            <br />
            making your own.
          </h2>
        </div>
        <div>
          <p>
            Caelora is in development.
            <br />
            No release date has been announced.
          </p>
          <a class="button secondary" href="/journal/foundation/">
            Follow the making <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <dialog class="art-viewer" aria-labelledby="viewer-title">
    <div class="viewer-toolbar">
      <span class="eyebrow">Caelora / Concept studies</span>
      <button type="button" class="viewer-close" aria-label="Close artwork">
        Close <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="viewer-image">
      <img id="viewer-image" alt="" width="1672" height="941" />
      <p class="viewer-error" role="status" hidden>
        Artwork could not be loaded. Close the viewer and try again.
      </p>
    </div>
    <div class="viewer-caption">
      <div>
        <h2 id="viewer-title">Concept study</h2>
        <p>Concept artwork. Not gameplay. Designs may change.</p>
      </div>
      <div class="viewer-controls">
        <button type="button" data-direction="-1" aria-label="Previous artwork">
          ←
        </button>
        <span class="viewer-position" aria-live="polite"></span>
        <button type="button" data-direction="1" aria-label="Next artwork">
          →
        </button>
      </div>
    </div>
  </dialog>
  <script>
    const viewer = document.querySelector<HTMLDialogElement>('.art-viewer');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-artwork]')];
    const image = document.querySelector<HTMLImageElement>('#viewer-image');
    const heading = document.querySelector<HTMLElement>('#viewer-title');
    const position = document.querySelector<HTMLElement>('.viewer-position');
    const error = document.querySelector<HTMLElement>('.viewer-error');
    let current = 0;
    let trigger: HTMLElement | null = null;
    function show(index: number) {
      current = (index + links.length) % links.length;
      const link = links[current];
      const source = link?.querySelector('img');
      if (!source || !image || !heading || !position || !error) return;
      error.hidden = true;
      image.src = link.href;
      image.alt = source.alt;
      heading.textContent =
        link.closest('figure')?.querySelector('figcaption > span')?.textContent ?? 'Concept study';
      position.textContent = current + 1 + ' / ' + links.length;
    }
    links.forEach((link, index) =>
      link.addEventListener('click', (event) => {
        if (!viewer) return;
        event.preventDefault();
        trigger = link;
        show(index);
        viewer.showModal();
      }),
    );
    viewer?.querySelector('.viewer-close')?.addEventListener('click', () => viewer.close());
    viewer
      ?.querySelectorAll<HTMLButtonElement>('[data-direction]')
      .forEach((button) =>
        button.addEventListener('click', () => show(current + Number(button.dataset.direction))),
      );
    viewer?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
    });
    viewer?.addEventListener('close', () => trigger?.focus());
    image?.addEventListener('error', () => {
      if (error) error.hidden = false;
    });
  </script>
</SiteLayout>
