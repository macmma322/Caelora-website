---
import SiteLayout from '../layouts/SiteLayout.astro';
import ValleyMap from '../components/ValleyMap.astro';
import ArtPicture from '../components/ArtPicture.astro';
import StatusTag from '../components/StatusTag.astro';
import { media, statusMeaning, type Status } from '../data/media';
import { places } from '../data/places';
import { journalEntries, entryUrl, formatDate, isoDate } from '../lib/journal';

const entries = (await journalEntries()).slice(0, 2);
---

<SiteLayout>
  <main id="main">
    <ValleyMap />

    <section class="overview section-space" id="overview" aria-labelledby="overview-title">
      <div class="container">
        <header class="systems-head" data-reveal>
          <span class="eyebrow">What you do in Caelora</span>
          <h2 id="overview-title">
            One valley. <em>Endless beginnings.</em>
          </h2>
          <p class="lede">
            There is no chosen one and no required ending. There is a valley, and five places to
            begin — each its own way of making a life.
          </p>
        </header>
        <ol class="places-index">
          {places.map((place) => (
            <li data-reveal>
              <a class:list={['place-card', `place-card-${place.id}`]} href={place.href}>
                <ArtPicture
                  class="place-card-art"
                  item={place.art}
                  sizes="(max-width:45rem) 92vw, (max-width:75rem) 46vw, 25vw"
                  alt=""
                />
                <span class="place-card-numeral" aria-hidden="true">
                  {place.numeral}
                </span>
                <span class="place-card-copy">
                  <span class="journal-meta">{place.verb}</span>
                  <span class="place-card-name">{place.name}</span>
                  <span class="place-card-summary">{place.summary}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <dl class="status-legend systems-legend" data-reveal>
          {(['development', 'planned', 'concept'] as Status[]).map((status) => (
            <div>
              <dt>
                <StatusTag status={status} />
              </dt>
              <dd>{statusMeaning[status]}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="studio section-space" id="journal" aria-labelledby="journal-title">
      <div class="container studio-grid">
        <div class="studio-head" data-reveal>
          <span class="eyebrow">From the development studio</span>
          <h2 id="journal-title">
            Built in the open, <em>one honest step at a time.</em>
          </h2>
          <p>
            The journal reports direction and work that can be shown. When something is only an
            intention, it says so.
          </p>
          <div class="studio-actions">
            <a class="button secondary" href="/journal/">
              All journal entries
            </a>
            <a class="text-link" href="/rss.xml">
              Follow with RSS <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <ol class="studio-entries">
          {entries.map((entry) => (
            <li data-reveal>
              <a class="studio-entry" href={entryUrl(entry)}>
                <ArtPicture
                  class="studio-entry-art"
                  item={media[entry.data.cover]}
                  sizes="(max-width:45rem) 92vw, 34vw"
                  alt=""
                />
                <span class="journal-meta">
                  {entry.data.category} ·{' '}
                  <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
                </span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <span class="text-link" aria-hidden="true">
                  Read the entry <span>↗</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <aside class="status-board" aria-labelledby="status-title" data-reveal>
          <h3 id="status-title">Where things stand</h3>
          <p class="status-board-date">
            As of <time datetime="2026-11-12">12 November 2026</time>
          </p>
          <dl>
            <div>
              <dt>The game</dt>
              <dd>Native Unity 6 sandbox for Windows</dd>
            </div>
            <div>
              <dt>Stage</dt>
              <dd>In development · building the first valley</dd>
            </div>
            <div>
              <dt>Public builds</dt>
              <dd>None yet</dd>
            </div>
            <div>
              <dt>Release date</dt>
              <dd>Not announced</dd>
            </div>
            <div>
              <dt>Price and purchases</dt>
              <dd>Not available</dd>
            </div>
            <div>
              <dt>Accounts</dt>
              <dd>Not open yet</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>
  </main>
  <script>
    import '../scripts/experience';
  </script>
</SiteLayout>
