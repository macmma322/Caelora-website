---
import '@caelora/design-tokens/tokens.css';
import '@caelora/design-tokens/base.css';
import '../styles/site.css';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Caelora · A world to call your own',
  description = 'Caelora is an independent medieval-fantasy voxel sandbox for Windows, in development: explore one wild valley, build a home, meet its creatures and choose your own way to belong.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/media/social-card-1200.jpg', Astro.site);
const accountUrl = import.meta.env.PUBLIC_ACCOUNT_URL;
const path = Astro.url.pathname;
const navigation = [
  { href: '/#world', label: 'The game', chapter: 'world' },
  { href: '/journal/', label: 'Development', section: '/journal/' },
  { href: '/media/', label: 'Media', section: '/media/' },
  { href: '/#community', label: 'Community', chapter: 'community' },
];
const current = (item: (typeof navigation)[number]) =>
  item.section && path.startsWith(item.section) ? 'page' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101c1c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Caelora development journal"
      href="/rss.xml"
    />
    <link
      rel="preload"
      href="/fonts/cinzel-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Caelora" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Caelora concept artwork: a cloaked traveller and a falcon overlooking a forested valley and castle at sunset."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/" aria-label="Caelora home">
          <img
            src="/brand/caelora-nav-360.webp"
            srcset="/brand/caelora-nav-240.webp 240w, /brand/caelora-nav-360.webp 360w, /brand/caelora-nav-480.webp 480w"
            sizes="(max-width:45rem) 138px, 170px"
            width="480"
            height="146"
            alt="Caelora"
          />
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} data-chapter={item.chapter} aria-current={current(item)}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-end">
          <span class="development-tag">
            <span class="status-dot" aria-hidden="true"></span>In development
          </span>
          {accountUrl && (
            <a class="portal-link" href={accountUrl}>
              Account
            </a>
          )}
          <details class="mobile-nav">
            <summary aria-label="Menu">
              Menu <span aria-hidden="true">☰</span>
            </summary>
            <nav aria-label="Mobile navigation">
              {navigation.map((item) => (
                <a href={item.href} aria-current={current(item)}>
                  {item.label}
                </a>
              ))}
              {accountUrl && <a href={accountUrl}>Account</a>}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-top">
        <div class="footer-brand">
          <a class="wordmark" href="/" aria-label="Caelora home">
            <img
              src="/brand/caelora-nav-360.webp"
              srcset="/brand/caelora-nav-240.webp 240w, /brand/caelora-nav-360.webp 360w, /brand/caelora-nav-480.webp 480w"
              sizes="(max-width:45rem) 180px, 220px"
              width="480"
              height="146"
              alt="Caelora"
              loading="lazy"
            />
          </a>
          <p>An independent medieval-fantasy voxel sandbox for Windows. In development.</p>
        </div>
        <nav aria-label="Footer navigation" class="footer-nav">
          <div>
            <span class="footer-heading">Explore</span>
            <a href="/#world">The game</a>
            <a href="/media/">Visual archive</a>
          </div>
          <div>
            <span class="footer-heading">Follow</span>
            <a href="/journal/">Development journal</a>
            <a href="/rss.xml">RSS feed</a>
          </div>
          <div>
            <span class="footer-heading">Project</span>
            <a href="/project-information/">Project information</a>
            <a href="/project-information/#legal">Legal & privacy</a>
            {accountUrl && <a href={accountUrl}>Account</a>}
          </div>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getUTCFullYear()} Caelora. All rights reserved.</span>
        <span>
          Images are concept art and model studies, not gameplay. No release date announced.
        </span>
      </div>
    </footer>
    <script>
      import '../scripts/navigation';
    </script>
  </body>
</html>
