---
import StatusTag from './StatusTag.astro';
import type { Status } from '../data/media';
// Reusable 3D study. The poster is the complete experience; WebGL is an opt-in enhancement that
// loads only when the visitor asks for it. Add a subject by supplying a web-ready GLB + poster.
interface Props {
  id: string;
  model: string;
  poster: { src: string; srcset?: string; width: number; height: number; alt: string };
  /** Short subject name used in control labels, e.g. "travel cloak". */
  subject: string;
  caption: string;
  status?: Status;
}
const { id, model, poster, subject, caption, status = 'model' } = Astro.props;
const titleId = `${id}-title`;
---

<section class="model-showcase" aria-labelledby={titleId} data-model-showcase data-model={model}>
  <div class="container model-showcase-grid">
    <div class="model-copy" data-reveal>
      <slot name="eyebrow" />
      <h2 id={titleId}>
        <slot name="title" />
      </h2>
      <slot />
      <StatusTag status={status} />
    </div>
    <figure class="model-stage" data-model-stage>
      <div class="model-viewport">
        <img
          class="model-poster"
          src={poster.src}
          srcset={poster.srcset}
          sizes="(max-width:60rem) 92vw, 620px"
          width={poster.width}
          height={poster.height}
          alt={poster.alt}
          loading="lazy"
          decoding="async"
        />
        <canvas
          hidden
          tabindex="0"
          aria-label={`Interactive 3D study of the ${subject}. Drag or use the arrow keys to turn it, plus and minus to zoom, zero to reset.`}
        ></canvas>
        <div class="model-controls" role="group" aria-label={`${subject} view controls`} hidden>
          <button type="button" data-model-turn="-1" aria-label={`Turn ${subject} left`}>
            ←
          </button>
          <button type="button" data-model-turn="1" aria-label={`Turn ${subject} right`}>
            →
          </button>
          <button type="button" data-model-zoom="1" aria-label="Zoom in">
            +
          </button>
          <button type="button" data-model-zoom="-1" aria-label="Zoom out">
            −
          </button>
          <button type="button" data-model-reset aria-label="Reset view">
            Reset
          </button>
        </div>
      </div>
      <div class="model-bar">
        <div class="model-start" hidden>
          <button type="button" class="button secondary" data-model-start>
            Inspect in 3D <span aria-hidden="true">⟲</span>
          </button>
          <span class="model-note">Optional · loads about 0.9 MB of WebGL</span>
        </div>
        <p class="model-message" role="status" aria-live="polite"></p>
      </div>
      <figcaption>{caption}</figcaption>
    </figure>
  </div>
</section>
<script>
  import '../scripts/model-showcase';
</script>
