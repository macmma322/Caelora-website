---
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---

<div class="section-heading">
  <span class="eyebrow">{label}</span>
  <h2>{title}</h2>
</div>
<style>
  .eyebrow {
    margin-bottom: 1.2rem;
  }
  h2 {
    font-size: var(--text-title);
    margin-bottom: 1.5rem;
  }
</style>
