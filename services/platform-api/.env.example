# Reference only: ASP.NET does not automatically load .env files.
# Use environment variables, dotnet user-secrets, or ignored appsettings.Local.json.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080
Platform__PublicOrigin=http://localhost:4321
Platform__CorsOrigins__0=http://localhost:4200
Platform__CorsOrigins__1=http://localhost:4300
Platform__PostgresEnabled=false
Platform__RedisEnabled=false
# Enable explicitly with Compose + bootstrap's ignored local settings.
# Platform__PostgresConnection=Host=localhost;Port=55432;Database=caelora;Username=caelora;Password=<local-generated-value>
# Platform__RedisConnection=localhost:56379,abortConnect=false,connectTimeout=2000
# Identity is explicitly opt-in. Native local setup: npm run infra:native
Accounts__Enabled=false
# Accounts__AccountOrigin=http://localhost:4200
# Accounts__EmailProvider=Mailpit
# Accounts__SmtpHost=127.0.0.1
# Accounts__SmtpPort=1025
# Accounts__SenderAddress=accounts@caelora.test
# Accounts__KeyDirectory=<absolute-persisted-directory>
# Outside local: use Smtp with injected credentials and key-at-rest certificate settings.
